# EchoArchitech AI - API Gateway Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Online Cluster Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/echoarchitect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://echo_user:echo_password@cluster0.mongodb.net/echoarchitect?retryWrites=true&w=majority

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# 100% Free AI Keys (Google Gemini Free Tier / Groq Free Tier)
GEMINI_API_KEY=
GROQ_API_KEY=

# Engine Microservice URL (Python Webhook & Monitoring Service)
ENGINE_URL=http://localhost:8000
